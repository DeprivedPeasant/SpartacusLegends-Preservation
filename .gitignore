# Keep the public repository limited to the preservation server source and
# release recipe. Reverse-engineering workspaces, game-derived data, logs,
# downloaded reference projects, and generated binaries remain local.
*

!.gitignore
!AGENTS.md
!CURRENT_HANDOFF.md
!README.md

!notes/
notes/*
!notes/07-v0.4-save-migration-plan.md

!packaging/
packaging/*
!packaging/build_release.ps1
!packaging/requirements-build.txt
!packaging/SpartacusLegends_ServerPatch.yml

!patches/
patches/*
!patches/SpartacusLegends_OfflineFix.yml

!tools/
tools/*
!tools/_version.py
!tools/prudp_server.py
!tools/spartacus_server.py
!tools/roster_bridge.py
!tools/legend_recovery.py
!tools/migration_coordinator.py
!tools/patch_installer.py
!tools/server_config.py
!tools/UbiOnlineConfigService/
tools/UbiOnlineConfigService/*
!tools/UbiOnlineConfigService/__init__.py
!tools/UbiOnlineConfigService/spartacus_onlineconfig.py

!tests/
tests/*
!tests/test_roster_bridge.py
!tests/test_legend_recovery.py
!tests/test_prudp_responses.py
!tests/test_economy_store.py
!tests/test_release_patch.py
!tests/test_patch_installer.py
!tests/test_migration_coordinator.py
!tests/test_migration_bridge.py
!tests/test_migration_upload_gate.py
!tests/test_migration_launcher.py
!tests/test_server_startup.py
!tests/test_title_versions.py

**/__pycache__/
*.py[cod]
